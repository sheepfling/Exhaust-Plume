{
  "$defs": {
    "HandoffApplicabilityV1": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "additionalProperties": true,
          "title": "Domain",
          "type": "object"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "violations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "supported"
      ],
      "title": "HandoffApplicabilityV1",
      "type": "object"
    },
    "HandoffFrameV1": {
      "additionalProperties": false,
      "description": "Frame identity and pose of that frame in its optional parent frame.",
      "properties": {
        "frame_id": {
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "parent_frame_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Frame Id"
        },
        "pose_parent_from_frame": {
          "$ref": "#/$defs/HandoffPoseV1"
        }
      },
      "required": [
        "frame_id",
        "pose_parent_from_frame"
      ],
      "title": "HandoffFrameV1",
      "type": "object"
    },
    "HandoffPoseV1": {
      "additionalProperties": false,
      "description": "Pose coordinates with quaternion order ``(x, y, z, w)``.",
      "properties": {
        "rotation_xyzw": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Rotation Xyzw",
          "type": "array"
        },
        "translation_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Translation M",
          "type": "array"
        }
      },
      "required": [
        "translation_m",
        "rotation_xyzw"
      ],
      "title": "HandoffPoseV1",
      "type": "object"
    },
    "HandoffProvenanceV1": {
      "additionalProperties": false,
      "description": "Source identity retained from the producer of this section.",
      "properties": {
        "asset_digests_sha256": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Asset Digests Sha256",
          "type": "array"
        },
        "code_revision": {
          "minLength": 1,
          "title": "Code Revision",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "producer_metadata": {
          "additionalProperties": true,
          "title": "Producer Metadata",
          "type": "object"
        }
      },
      "required": [
